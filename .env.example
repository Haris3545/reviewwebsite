# Apify API token (recommended data source). Free tier available at apify.com.
# Create an account, then find your token under Settings -> Integrations.
APIFY_TOKEN=

# Set to "true" to allow the direct-scraper fallback when APIFY_TOKEN is not set.
# Warning: this fetches Amazon pages directly, which violates Amazon's Terms
# of Service and may get your IP rate-limited or blocked. Off by default.
ALLOW_SCRAPER_FALLBACK=false
